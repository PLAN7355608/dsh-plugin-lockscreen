{
  "name": "dsh-plugin-lockscreen",
  "version": "0.1.4",
  "private": true,
  "description": "锁屏插件：手动锁住 DeepSeek Harness 窗口，用数字 PIN 或文字口令解锁。TUI（字符界面）风格。",
  "type": "module",
  "main": "index.js",
  "icon": "icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/",
    "cordis.patch.yml",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "keywords": [
    "dsh-plugin",
    "lockscreen",
    "lock",
    "tui",
    "deepseek-harness"
  ],
  "license": "MIT"
}
